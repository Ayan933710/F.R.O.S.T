# ─── Backend Environment Variables ───
# MongoDB connection string (REQUIRED on AWS)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/frost?retryWrites=true&w=majority

# Server port (defaults to 5000)
PORT=5000

# ML microservice URL (defaults to http://localhost:8000)
ML_URL=http://localhost:8000

# JWT secret for authentication (CHANGE IN PRODUCTION!)
JWT_SECRET=your-secure-secret-key-here

# CORS origin(s) — comma-separated if multiple (defaults to allow all if not set)
# CORS_ORIGIN=https://your-frontend-domain.com,http://localhost:5173
