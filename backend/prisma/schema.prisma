// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model CrdtSnapshot {
  id         Int      @id @default(autoincrement())
  doc_id     String   @unique
  state      Bytes?
  updated_at DateTime @default(now())
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password_hash String?
  name          String?
  role          String   @default("commander")
  station       String?
  created_at    DateTime @default(now())
}

model Expedition {
  id                Int       @id @default(autoincrement())
  expedition_id     String    @unique
  name              String?
  season            String?
  start_date        DateTime?
  end_date          DateTime?
  milestones        Json?     
  budget            Json?     
  charter_schedule  Json?     
  budget_allocation Json?     
  status            String    @default("Planning")
}

model Roster {
  id             Int     @id @default(autoincrement())
  personnel_id   String  @unique
  name           String?
  role           String?
  specialization String?
  team           String? 
  expedition_id  String?
  blood_type     String?
  allergies      String?
  station        String?
}

model Geofence {
  id          Int     @id @default(autoincrement())
  geofence_id String  @unique
  name        String?
  type        String  @default("crevasse")
  coordinates Json?   
  station     String?
  active      Boolean @default(true)
}

model Item {
  id                 Int       @id @default(autoincrement())
  item_id            String?
  name               String?
  category           String?
  quantity           Float?
  unit               String?
  station            String?
  critical_threshold Float?
  last_updated       DateTime?
}

model InventoryMovement {
  id                 Int       @id @default(autoincrement())
  client_event_id    String?   @unique
  station            String
  item_id            String
  name               String
  category           String?
  unit               String?
  quantity_delta     Float
  stock_after        Float
  critical_threshold Float?
  lead_time_days     Int?
  unit_cost          Float?
  movement_type      String
  event_type         String?
  recorded_at        DateTime  @default(now())

  @@index([station])
  @@index([item_id])
  @@index([recorded_at])
}

model Requisition {
  id             Int      @id @default(autoincrement())
  requisition_id String   @unique
  station        String
  item           String
  quantity       Float
  unit           String?
  urgency        String   @default("ROUTINE")
  status         String   @default("PENDING_APPROVAL")
  decided_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  @@index([station])
  @@index([created_at])
}

model Manifest {
  id                  Int       @id @default(autoincrement())
  manifest_id         String    @unique
  status              String    @default("Draft")
  items               Json      
  destination         String?
  vessel              String?
  vessel_mmsi         String?
  crypto_hash         String?
  sealed_at           DateTime?
  sealed_payload_json String?
  tamper_detected     Boolean   @default(false)
  tamper_alerts       Json?     @default("[]")
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now())
}

model Telemetry {
  id           Int       @id @default(autoincrement())
  node_id      String?
  personnel_id String?
  lat          Float?
  lng          Float?
  battery_pct  Float?
  status       String?
  timestamp    DateTime?
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  log_id         String   @unique
  timestamp      DateTime @default(now())
  category       String
  action         String
  severity       String   @default("info")
  admin_id       String?
  commander_id   String?
  details        String?
  status         String?
  signature_hash String?
}
