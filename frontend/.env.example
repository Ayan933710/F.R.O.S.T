# ─── Frontend Environment Variables (Vite) ───
# Backend API base URL (no trailing slash)
# On AWS, set this to your backend's public URL e.g. http://<ec2-ip>:5000
# If running as single-process (backend serves frontend), leave empty or use empty string
VITE_API_URL=

# WebSocket URL for CRDT sync and telemetry
# On AWS, set this to ws://<ec2-ip>:5000
VITE_WS_URL=
